# Sanity project ID from https://sanity.io/manage (or `npx sanity init --bare`).
PUBLIC_SANITY_PROJECT_ID=""
PUBLIC_SANITY_DATASET="production"

# Not needed to build the site - the dataset is readable without one. Needed
# for `sanity documents validate` and `sanity dataset export`. Create it with
# Editor permissions at sanity.io/manage -> API -> Tokens. Never commit it.
SANITY_WRITE_TOKEN=""

# Web3Forms access key for the contact form - get one at web3forms.com
PUBLIC_WEB3FORMS_KEY=""

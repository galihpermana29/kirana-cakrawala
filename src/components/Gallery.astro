---
import { urlFor } from '../lib/image';
import type { GallerySection } from '../lib/types';

interface Props {
  section: GallerySection;
}

const { section } = Astro.props;
const images = (section.images ?? []).filter((image) => image.asset);
---

{
  images.length > 0 && (
    <section class="section" id="gallery">
      <div class="container">
        {section.heading && <h2 class="section-heading">{section.heading}</h2>}
        <div class="grid">
          {images.map((image) => (
            <img
              src={urlFor(image).width(800).height(600).url()}
              alt={image.alt ?? ''}
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.5rem;
  }
</style>

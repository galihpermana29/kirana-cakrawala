---
import { urlFor } from '../lib/image';
import type { HeroSection } from '../lib/types';

interface Props {
  section: HeroSection;
}

const { section } = Astro.props;
const bgUrl = section.image?.asset
  ? urlFor(section.image).width(2000).height(1100).url()
  : null;
---

<section class="hero" class:list={{ 'has-image': Boolean(bgUrl) }}>
  {bgUrl && <img class="hero-bg" src={bgUrl} alt="" loading="eager" />}
  <div class="container hero-inner">
    <h1>{section.heading}</h1>
    {section.subheading && <p class="hero-sub">{section.subheading}</p>}
    {
      section.ctaLabel && section.ctaHref && (
        <a class="button" href={section.ctaHref}>
          {section.ctaLabel}
        </a>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(85vh, 44rem);
    padding-block: var(--section-padding);
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--color-primary) 8%, #fff),
      color-mix(in srgb, var(--color-accent) 10%, #fff)
    );
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .has-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-primary) 55%, transparent);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }

  .has-image h1,
  .has-image .hero-sub {
    color: #fff;
  }

  .hero-sub {
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 38rem;
  }
</style>

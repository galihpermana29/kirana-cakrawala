---
import type { Section } from '../lib/types';
import About from './About.astro';
import Contact from './Contact.astro';
import Gallery from './Gallery.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';

interface Props {
  section: Section;
}

const { section } = Astro.props;
---

{section._type === 'heroSection' && <Hero section={section} />}
{section._type === 'aboutSection' && <About section={section} />}
{section._type === 'servicesSection' && <Services section={section} />}
{section._type === 'gallerySection' && <Gallery section={section} />}
{section._type === 'contactSection' && <Contact section={section} />}

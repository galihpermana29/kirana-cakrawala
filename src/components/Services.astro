---
import { urlFor } from '../lib/image';
import type { ServicesSection } from '../lib/types';

interface Props {
  section: ServicesSection;
}

const { section } = Astro.props;
const items = section.items ?? [];
---

<section class="section" id="services">
  <div class="container">
    <div class="section-heading">
      <h2>{section.heading}</h2>
      {section.intro && <p class="section-intro">{section.intro}</p>}
    </div>
    <div class="grid">
      {
        items.map((item) => (
          <article class="card">
            {item.image?.asset && (
              <img
                src={urlFor(item.image).width(800).height(500).url()}
                alt={item.title}
                class="card-image"
                loading="lazy"
              />
            )}
            <div class="card-body">
              <h3>{item.title}</h3>
              {item.description && <p>{item.description}</p>}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }

  .card {
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: box-shadow 150ms ease;
  }

  .card:hover {
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }

  .card-body {
    padding: 1.5rem;
    display: grid;
    gap: 0.5rem;
  }

  .card-body p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>

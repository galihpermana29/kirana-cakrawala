---
import {
  GOVERNANCE_ANCHOR,
  pad,
  type AboutGovernanceSection,
} from '../../content/about';

interface Props {
  content: AboutGovernanceSection;
}

const { content } = Astro.props;
---

<!-- Mission 6 expanded: the six things KCA does not compromise on, one card
     each. Trust is what an aviation buyer is really purchasing, so this is
     the page's second navy moment. -->
<section class="band-navy section governance" id={GOVERNANCE_ANCHOR} data-governance>
  <div class="container">
    <p class="section-label" data-governance-label>{content.label}</p>
    <div class="section-head governance-head">
      <p class="mission-tag">
        <span class="mission-number">{content.missionLabel} {pad(content.mission.number)}</span>
        <span class="mission-title">{content.mission.title}</span>
      </p>
      <h2>{content.heading}</h2>
      <p class="section-intro">{content.intro}</p>
    </div>
    <div class="principle-grid">
      {
        content.principles.map((principle, i) => (
          <article class="principle-card" data-principle-card>
            <p class="principle-index">{pad(i + 1)}</p>
            <h3 class="principle-title">{principle.title}</h3>
            <p class="principle-description">{principle.description}</p>
          </article>
        ))
      }
    </div>
    <div class="governance-reading" data-governance-reading>
      <div class="reading-copy">
        <p class="reading-label">{content.readingLabel}</p>
        <p class="reading-title">{content.readingArticle.title}</p>
      </div>
      <a class="btn btn-ghost" href={content.readingArticle.href}>
        {content.readingLinkLabel}<span class="btn-arrow" aria-hidden="true">›</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap, motionReady, revealUp, scrambleIn, EASE, REVEAL_START } from '../../lib/motion';

  const section = document.querySelector('[data-governance]');
  const label = document.querySelector('[data-governance-label]');
  const reading = document.querySelector('[data-governance-reading]');

  if (section && label) {
    const enter = () => {
      scrambleIn(label, { trigger: section });
      revealUp('[data-governance] .governance-head > *', {
        trigger: section,
        stagger: 0.09,
      });
      gsap.from('[data-principle-card]', {
        autoAlpha: 0,
        y: 34,
        duration: 0.7,
        ease: EASE,
        stagger: 0.08,
        scrollTrigger: { trigger: '[data-governance] .principle-grid', start: REVEAL_START },
      });
      if (reading) {
        revealUp('[data-governance-reading] > *', {
          trigger: reading,
          stagger: 0.08,
          y: 16,
          duration: 0.6,
        });
      }
    };
    motionReady(section, { desktop: enter, mobile: enter });
  }
</script>

<style>
  .mission-tag {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .mission-number {
    color: var(--orange);
    font-weight: 700;
  }

  .mission-number::after {
    content: ' /';
    color: rgba(255, 255, 255, 0.35);
    font-weight: 400;
  }

  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .principle-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 1.75rem;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    transition:
      background 180ms ease,
      border-color 180ms ease;
  }

  /* Orange top rule that draws across on hover - transform only. The cards
     are not links, so no grow or press: the highlight is a reading aid. */
  .principle-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 260ms var(--ease-out-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .principle-card:hover {
      background: rgba(255, 255, 255, 0.07);
      border-color: rgba(249, 156, 36, 0.45);
    }

    .principle-card:hover::before {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .principle-card::before {
      transition: none;
    }
  }

  .principle-index {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--orange);
  }

  .principle-title {
    font-size: 1.02rem;
  }

  .principle-description {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.95rem;
  }

  /* Out to the article that goes deeper. */
  .governance-reading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .reading-copy {
    display: grid;
    gap: 0.4rem;
  }

  .reading-label {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .reading-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: 0.95rem;
    color: #fff;
    max-width: 34rem;
  }

  @media (max-width: 1023.98px) {
    .principle-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639.98px) {
    .principle-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { pad, type ChannelsContent } from '../../content/contact';

interface Props {
  content: ChannelsContent;
}

const { content } = Astro.props;
---

<!-- The three ways in, each a card that is itself the action: the email
     card writes, the phone card dials, the office card jumps to the map. -->
<section class="section channels" data-channels>
  <div class="container">
    <p class="section-label" data-channels-label>{content.label}</p>
    <div class="section-head">
      <h2>{content.heading}</h2>
      <p class="section-intro">{content.intro}</p>
    </div>
    <div class="channel-cards">
      {
        content.items.map((channel) => (
          <a class="channel-card" href={channel.href} data-channel-card>
            <p class="channel-eyebrow">
              <span class="channel-index">{pad(channel.index)}</span>
              <span>{channel.name}</span>
            </p>
            <p class="channel-value">{channel.value}</p>
            <p class="channel-description">{channel.description}</p>
            <span class="channel-action">
              {channel.action}<span class="btn-arrow" aria-hidden="true">›</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap, motionReady, revealUp, scrambleIn, EASE, REVEAL_START } from '../../lib/motion';

  const section = document.querySelector('[data-channels]');
  const label = document.querySelector('[data-channels-label]');

  if (section && label) {
    const enter = () => {
      scrambleIn(label, { trigger: section });
      revealUp('[data-channels] .section-head > *', { trigger: section, stagger: 0.09 });
      gsap.from('[data-channel-card]', {
        autoAlpha: 0,
        y: 34,
        duration: 0.7,
        ease: EASE,
        stagger: 0.1,
        scrollTrigger: { trigger: '[data-channels] .channel-cards', start: REVEAL_START },
      });
    };
    motionReady(section, { desktop: enter, mobile: enter });
  }
</script>

<style>
  .channel-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .channel-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.75rem;
    overflow: hidden;
    padding: 1.75rem 1.75rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow 200ms var(--ease-out-expo),
      transform 140ms var(--ease-out-quad),
      border-color 150ms ease;
  }

  /* Orange rule along the top, drawn in on hover. */
  .channel-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 260ms var(--ease-out-expo);
  }

  .channel-card:active {
    transform: scale(0.99);
    transition-duration: 90ms;
  }

  .channel-card:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .channel-eyebrow {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
    color: var(--slate);
  }

  .channel-index {
    color: var(--orange);
    font-weight: 700;
  }

  .channel-index::after {
    content: ' /';
    color: var(--slate);
    font-weight: 400;
  }

  /* The address, number, or district in display type - the card's object. */
  .channel-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--navy);
    overflow-wrap: anywhere;
  }

  .channel-description {
    color: var(--slate);
    font-size: 0.93rem;
  }

  .channel-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--blue);
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .channel-card:hover {
      transform: scale(1.01);
      border-color: rgba(0, 130, 202, 0.35);
      box-shadow: 0 14px 34px rgba(1, 30, 65, 0.1);
    }

    .channel-card:hover::before {
      transform: scaleX(1);
    }

    .channel-card:hover .channel-action {
      color: var(--orange);
    }

    .channel-card:hover .btn-arrow {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-card,
    .channel-card:hover,
    .channel-card:active {
      transform: none;
    }

    .channel-card::before {
      transition: none;
    }

    .channel-card:hover .btn-arrow {
      transform: none;
    }
  }

  @media (max-width: 1023.98px) {
    .channel-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .channel-value {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 639.98px) {
    .channel-cards {
      grid-template-columns: 1fr;
    }
  }
</style>

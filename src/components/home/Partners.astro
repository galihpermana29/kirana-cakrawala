---
import type { EcosystemSection } from '../../content/home';
import NetworkMap from '../partners/NetworkMap.astro';

interface Props {
  section: EcosystemSection;
  brandAbbr: string;
}

const { section: ecosystem, brandAbbr } = Astro.props;
---

<section class="section" id="ecosystem" data-partners>
  <div class="container">
    <p class="section-label" data-partners-label>{ecosystem.label}</p>
    <div class="partners-head">
      <div>
        <h2>{ecosystem.heading}</h2>
        <p class="section-intro">{ecosystem.intro}</p>
      </div>
      <a class="btn btn-ghost" href={ecosystem.link.href}>
        {ecosystem.link.label}<span class="btn-arrow" aria-hidden="true">›</span>
      </a>
    </div>
  </div>

  <div class="container">
    <NetworkMap regions={ecosystem.regions} hq={ecosystem.hq} brandAbbr={brandAbbr} />
  </div>

  <!-- Each category scrolls past as a link into its tab on the Partners page;
       the second copy only closes the loop, so it is hidden and unfocusable. -->
  <div class="partners-marquee" data-partners-marquee aria-label="Partner categories">
    <div class="marquee-track">
      {
        [0, 1].map((copy) => (
          <div class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {ecosystem.categories.map((category) => (
              <a
                class="marquee-item"
                href={category.href}
                tabindex={copy === 1 ? -1 : undefined}
              >
                {category.name}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap, motionReady, revealUp, scrambleIn } from '../../lib/motion';

  const section = document.querySelector('[data-partners]');
  const label = document.querySelector('[data-partners-label]');

  if (section && label) {
    const enter = () => {
      scrambleIn(label, { trigger: section });
      revealUp('[data-partners] .partners-head > *', {
        trigger: section,
        stagger: 0.09,
      });
      // The map animates itself (NetworkMap). The marquee already moves
      // sideways - it only needs to fade in.
      gsap.from('[data-partners-marquee]', {
        autoAlpha: 0,
        duration: 0.9,
        ease: 'power2.out',
        scrollTrigger: { trigger: '[data-partners-marquee]', start: 'top 82%' },
      });
    };
    motionReady(section, { desktop: enter, mobile: enter });
  }
</script>

<style>
  .partners-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .partners-head h2 {
    margin-bottom: 0.75rem;
  }

  .partners-marquee {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border-block: 1px solid var(--line);
    overflow: hidden;
    padding-block: 1.15rem;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 26s linear infinite;
  }

  /* Holds still under the cursor so a category can be clicked. */
  .partners-marquee:hover .marquee-track,
  .partners-marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation-play-state: paused;
    }
  }

  .marquee-group {
    display: flex;
  }

  .marquee-item {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    font-size: clamp(1rem, 2.2vw, 1.4rem);
    color: var(--slate);
    text-decoration: none;
    padding-inline: clamp(1.5rem, 4vw, 3rem);
    white-space: nowrap;
    transition:
      color 150ms ease,
      transform 120ms var(--ease-out-quad);
  }

  .marquee-item:active {
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-item,
    .marquee-item:active {
      transform: none;
    }
  }

  .marquee-item:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .marquee-item:hover {
      color: var(--navy);
    }
  }

  .marquee-item::after {
    content: '·';
    color: var(--orange);
    margin-left: clamp(3rem, 8vw, 6rem);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>

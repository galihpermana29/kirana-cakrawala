---
import {
  categoryLabels,
  newsLabels,
  shortDate,
  type Article,
} from '../../content/news';

interface Props {
  article: Article;
  /* The newest article on the listing: spans the grid, image beside copy. */
  featured?: boolean;
  loading?: 'eager' | 'lazy';
}

const { article, featured = false, loading = 'lazy' } = Astro.props;
---

<!-- The homepage news card with a picture on top; the listing, the article
     cross-links, and the featured slot all render this one anatomy. -->
<a
  class:list={['article-card', { featured }]}
  href={article.href}
  data-article-card
  data-category={article.category}
>
  <div class="card-media">
    <img src={article.image.src} alt={article.image.alt} loading={loading} />
    <div class="card-tint" aria-hidden="true"></div>
    <span class="card-tag">{categoryLabels[article.category]}</span>
  </div>
  <div class="card-body">
    {featured && <p class="card-eyebrow">{newsLabels.latest}</p>}
    <p class="card-meta">
      <time datetime={article.date}>{shortDate(article.date)}</time>
      <span class="meta-sep" aria-hidden="true">/</span>
      <span class="card-read">{article.readingMinutes} {newsLabels.minRead}</span>
    </p>
    <h3 class="card-title">{article.title}</h3>
    <p class="card-excerpt">{article.excerpt}</p>
    <span class="card-more">
      {newsLabels.readArticle}<span class="btn-arrow" aria-hidden="true">›</span>
    </span>
  </div>
</a>

<style>
  .article-card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow 200ms var(--ease-out-expo),
      transform 140ms var(--ease-out-quad),
      border-color 150ms ease;
  }

  /* The listing filter hides cards with the hidden attribute; the display
     above would otherwise win over the UA stylesheet. */
  .article-card[hidden] {
    display: none;
  }

  .article-card:active {
    transform: scale(0.99);
    transition-duration: 90ms;
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--navy-deep);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 280ms var(--ease-out-expo);
  }

  .card-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(1, 30, 65, 0.62), rgba(1, 30, 65, 0.04) 55%);
  }

  .card-tag {
    position: absolute;
    left: 1.1rem;
    bottom: 1rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.68rem;
    font-weight: 700;
    color: #fff;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(1, 30, 65, 0.45);
    backdrop-filter: blur(6px);
  }

  /* Meta, title, excerpt, then the link pinned to the foot so "Read article"
     lines up across cards of differing length. */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.5rem 1.5rem 1.6rem;
  }

  .card-eyebrow {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--orange);
  }

  .card-eyebrow::before {
    content: '/ ';
  }

  .card-meta {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--orange);
  }

  .meta-sep {
    color: rgba(1, 30, 65, 0.3);
  }

  .card-read {
    color: var(--slate);
  }

  .card-title {
    font-size: 1.05rem;
  }

  .card-excerpt {
    color: var(--slate);
    font-size: 0.93rem;
  }

  .card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.3rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--blue);
    transition: color 150ms ease;
  }

  /* Featured: full row, picture beside copy, bigger title. */
  .article-card.featured {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-rows: none;
  }

  .featured .card-media {
    aspect-ratio: auto;
    min-height: 22rem;
  }

  .featured .card-body {
    justify-content: center;
    padding: clamp(1.75rem, 3vw, 2.75rem);
  }

  .featured .card-title {
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
  }

  .featured .card-excerpt {
    font-size: 1.02rem;
    max-width: 34rem;
  }

  .featured .card-more {
    margin-top: 0.4rem;
  }

  /* Grow toward the cursor, push the image in, lead with the chevron. */
  @media (hover: hover) and (pointer: fine) {
    .article-card:hover {
      transform: scale(1.01);
      border-color: rgba(0, 130, 202, 0.35);
      box-shadow: 0 14px 34px rgba(1, 30, 65, 0.1);
    }

    .article-card:hover .card-media img {
      transform: scale(1.05);
    }

    .article-card:hover .card-more {
      color: var(--orange);
    }

    .article-card:hover .btn-arrow {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card,
    .article-card:hover,
    .article-card:active {
      transform: none;
    }

    .article-card:hover .card-media img,
    .article-card:hover .btn-arrow {
      transform: none;
    }
  }

  @media (max-width: 1023.98px) {
    .article-card.featured {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    .featured .card-media {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }

    .featured .card-body {
      justify-content: flex-start;
    }
  }
</style>

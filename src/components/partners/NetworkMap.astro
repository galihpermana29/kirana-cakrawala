---
import DottedMap from 'dotted-map';
import type { MapPin } from '../../content/home';

interface Props {
  /* The neutral nodes, and the anchor the arcs radiate from. */
  regions: MapPin[];
  hq: MapPin;
  brandAbbr: string;
  /* Dot rows in the generated map; more rows keep the density up when the
     map is rendered wider. The homepage uses 60, the Partners page 80. */
  height?: number;
  /* Draw HQ-to-region connections over the map, with travelling signals. */
  arcs?: boolean;
  /* Show the region labels without hover at desktop widths. */
  labelled?: boolean;
}

const {
  regions,
  hq: hqPin,
  brandAbbr,
  height = 60,
  arcs = false,
  labelled = false,
} = Astro.props;

// Build-time generation; the SVG is static markup by the time it ships.
const map = new DottedMap({ height, grid: 'diagonal' });
const mapSvg = map.getSVG({
  shape: 'circle',
  color: '#c3cddb',
  backgroundColor: 'transparent',
  radius: 0.32,
});

// The arcs share the dot map's coordinate space so a second SVG laid over
// it lines up with the pins, which are placed in percentages of the box.
const { width: mapWidth, height: mapHeight } = map.image;
const viewBox = `0 0 ${mapWidth} ${mapHeight}`;
const toMap = (node: MapPin) => ({
  x: (node.xPct / 100) * mapWidth,
  y: (node.yPct / 100) * mapHeight,
});
const hq = toMap(hqPin);
// Quadratic arcs bowed northward, lifted in proportion to their span so the
// long routes clear the pins they pass.
const connections = regions.map((node) => {
  const to = toMap(node);
  const span = Math.hypot(to.x - hq.x, to.y - hq.y);
  const lift = Math.min(mapHeight * 0.6, span * 0.5);
  const control = { x: (hq.x + to.x) / 2, y: (hq.y + to.y) / 2 - lift };
  return {
    name: node.name,
    d: `M ${hq.x} ${hq.y} Q ${control.x} ${control.y} ${to.x} ${to.y}`,
  };
});
const signalRadius = (mapHeight * 0.011).toFixed(2);
// Pins on the right third would push their labels off a phone-width map, so
// those labels sit on the pin's left instead.
const flipsLabel = (node: MapPin) => node.xPct > 65;
---

<div class:list={['network-map', { labelled }]} data-network-map>
  <div class="network-map-dots" set:html={mapSvg} />
  {
    arcs && (
      <svg class="network-arcs" viewBox={viewBox} aria-hidden="true" data-network-arcs>
        {connections.map((arc) => (
          <path
            class="network-arc"
            d={arc.d}
            vector-effect="non-scaling-stroke"
            data-network-arc
            data-name={arc.name}
          />
        ))}
        {connections.map(() => (
          <circle class="network-signal" r={signalRadius} data-network-signal />
        ))}
      </svg>
    )
  }
  {
    regions.map((node) => (
      <button
        type="button"
        class:list={['map-pin', { 'map-pin-flip': flipsLabel(node) }]}
        style={`left: ${node.xPct}%; top: ${node.yPct}%`}
        aria-label={node.name}
        data-map-pin
      >
        <span class="map-pin-pulse" aria-hidden="true" />
        <span class="map-pin-label">{node.name}</span>
      </button>
    ))
  }
  <span
    class:list={['map-pin', 'map-pin-hq', { 'map-pin-flip': flipsLabel(hqPin) }]}
    style={`left: ${hqPin.xPct}%; top: ${hqPin.yPct}%`}
    data-map-pin-hq
  >
    <span class="map-pin-pulse" aria-hidden="true"></span>
    <span class="map-pin-label map-pin-label-fixed">{brandAbbr} - {hqPin.name}</span>
  </span>
</div>

<script>
  import { gsap, motionReady, EASE, REVEAL_START } from '../../lib/motion';

  document.querySelectorAll<HTMLElement>('[data-network-map]').forEach((map) => {
    const pins = Array.from(map.querySelectorAll<HTMLElement>('[data-map-pin]'));
    const arcs = Array.from(map.querySelectorAll<SVGPathElement>('[data-network-arc]'));
    const signals = Array.from(map.querySelectorAll<SVGCircleElement>('[data-network-signal]'));

    // Tap-to-toggle labels for touch; one open at a time, outside tap closes.
    pins.forEach((pin) => {
      pin.addEventListener('click', (event) => {
        event.stopPropagation();
        pins.forEach((other) => other !== pin && other.classList.remove('active'));
        pin.classList.toggle('active');
      });
    });
    document.addEventListener('click', () =>
      pins.forEach((pin) => pin.classList.remove('active')),
    );

    const enter = () => {
      const trigger = { trigger: map, start: REVEAL_START };
      // The map settles up, the pins pop in a file, then the connections
      // fade in from HQ outward.
      gsap.from(map, { autoAlpha: 0, y: 40, duration: 0.9, ease: EASE, scrollTrigger: trigger });
      // Once popped, the inline transform is cleared so the stylesheet's
      // percentage centring and hover scale apply again.
      gsap.from(map.querySelectorAll('.map-pin'), {
        scale: 0.4,
        transformOrigin: 'center',
        duration: 0.45,
        ease: 'back.out(2.5)',
        stagger: 0.1,
        delay: 0.35,
        clearProps: 'transform,transformOrigin',
        scrollTrigger: trigger,
      });
      if (arcs.length) {
        gsap.from(arcs, {
          autoAlpha: 0,
          duration: 0.8,
          ease: EASE,
          stagger: 0.12,
          delay: 0.8,
          scrollTrigger: trigger,
        });
      }
      // A signal travels each connection from HQ to its region and back
      // around: transform and opacity only, sampled along the path.
      arcs.forEach((arc, i) => {
        const signal = signals[i];
        if (!signal) return;
        const length = arc.getTotalLength();
        const state = { t: 0 };
        gsap.to(state, {
          t: 1,
          duration: 3.4,
          delay: 1.6 + i * 0.45,
          repeat: -1,
          repeatDelay: 0.9,
          ease: 'sine.inOut',
          scrollTrigger: {
            trigger: map,
            start: REVEAL_START,
            // Idle while scrolled away - nothing to see, nothing to spend.
            toggleActions: 'play pause resume pause',
          },
          onUpdate: () => {
            const point = arc.getPointAtLength(state.t * length);
            const edge = Math.min(1, state.t / 0.12, (1 - state.t) / 0.12);
            gsap.set(signal, { x: point.x, y: point.y, opacity: edge });
          },
        });
      });
    };
    motionReady(map, { desktop: enter, mobile: enter });
  });
</script>

<style>
  .network-map {
    position: relative;
    container-type: inline-size;
  }

  .network-map-dots :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .network-arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .network-arc {
    fill: none;
    stroke: rgba(0, 130, 202, 0.45);
    stroke-width: 1.25px;
    stroke-linecap: round;
  }

  /* Placed by the script; invisible until it moves one. */
  .network-signal {
    fill: var(--orange);
    opacity: 0;
  }

  /* Pin geometry rides on font-size so everything scales with the map. */
  .map-pin {
    position: absolute;
    font-size: clamp(16px, 2.2cqw, 30px);
    width: 1em;
    height: 1em;
    padding: 0;
    cursor: pointer;
    border-radius: 50%;
    background: var(--orange);
    border: 3px solid #fff;
    transform: translate(-50%, -50%);
    box-shadow:
      0 0 0 0.22em rgba(249, 156, 36, 0.3),
      0 4px 14px rgba(1, 30, 65, 0.25);
    transition: transform 160ms var(--ease-out-expo);
  }

  /* Soft glow patch marking the whole region, not just the point. */
  .map-pin::before {
    content: '';
    position: absolute;
    inset: -1.6em;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(249, 156, 36, 0.22), transparent 65%);
    pointer-events: none;
  }

  .map-pin-hq::before {
    background: radial-gradient(circle, rgba(0, 130, 202, 0.24), transparent 65%);
  }

  .map-pin-pulse {
    position: absolute;
    inset: -0.55em;
    border-radius: 50%;
    border: 2px solid var(--orange);
    animation: pin-pulse 2.2s ease-out infinite;
  }

  @keyframes pin-pulse {
    0% {
      transform: scale(0.45);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .map-pin-hq {
    background: var(--blue);
    box-shadow: 0 0 0 3px rgba(0, 130, 202, 0.22);
    cursor: default;
  }

  .map-pin-hq .map-pin-pulse {
    border-color: var(--blue);
  }

  /* Labels appear on hover (mouse), tap-toggle (touch), or focus. */
  .map-pin-label {
    position: absolute;
    left: 1.3em;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-display);
    font-size: clamp(12px, 0.62em, 18px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy);
    white-space: nowrap;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.85);
    padding: 0.15em 0.45em;
    border-radius: 0.3em;
    opacity: 0;
    transform: translateX(-0.25em);
    transition:
      opacity 140ms ease,
      transform 200ms var(--ease-out-expo);
  }

  .map-pin.active .map-pin-label,
  .map-pin:focus-visible .map-pin-label {
    opacity: 1;
    transform: translateX(0);
  }

  /* The HQ label is the map's anchor - always on. */
  .map-pin-label-fixed {
    color: var(--blue);
    opacity: 1;
    transform: none;
  }

  /* Phones: right-side pins label leftward, so nothing leaves the map. */
  @media (max-width: 767.98px) {
    .map-pin-flip .map-pin-label {
      left: auto;
      right: 1.3em;
      transform: translateX(0.25em);
    }

    .map-pin-flip.active .map-pin-label,
    .map-pin-flip:focus-visible .map-pin-label,
    .map-pin-flip .map-pin-label-fixed {
      transform: translateX(0);
    }
  }

  /* The large map has room to name its regions outright. */
  @media (min-width: 1024px) {
    .labelled .map-pin-label {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .map-pin:not(.map-pin-hq):hover {
      transform: translate(-50%, -50%) scale(1.3);
    }

    .map-pin:hover .map-pin-label {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-pin-label {
      transition: none;
      transform: none;
    }

    .map-pin-pulse {
      animation: none;
      opacity: 0.35;
    }

    .map-pin,
    .map-pin:hover {
      transform: translate(-50%, -50%);
    }
  }
</style>

---
import {
  pad,
  whatWeDoLabels,
  type PillarPage,
  type SectionIntro,
} from '../../content/what-we-do';

interface Props {
  head: SectionIntro;
  items: PillarPage[];
}

const { head, items } = Astro.props;
---

<!-- Cross-links between pillars: the hub shows all four, a pillar page the
     other three. -->
<section class="section pillar-grid" id="explore" data-pillar-grid>
  <div class="container">
    <p class="section-label" data-pillar-grid-label>{head.label}</p>
    <div class="section-head">
      <h2>{head.heading}</h2>
      <p class="section-intro">{head.intro}</p>
    </div>
    <div class="pillar-cards" style={`--cols: ${items.length}`}>
      {
        items.map((pillar) => (
          <a class="pillar-card" href={pillar.href} data-pillar-card>
            <div class="pillar-card-media">
              <img src={pillar.image.src} alt={pillar.image.alt} loading="lazy" />
              <div class="pillar-card-tint" aria-hidden="true" />
              <span class="pillar-card-index" aria-hidden="true">
                {pad(pillar.index)}
              </span>
            </div>
            <div class="pillar-card-body">
              <h3 class="pillar-card-name">{pillar.name}</h3>
              <p class="pillar-card-description">{pillar.description}</p>
              <span class="pillar-card-more">
                {whatWeDoLabels.explorePillar}<span class="btn-arrow" aria-hidden="true">›</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap, motionReady, revealUp, scrambleIn, EASE, REVEAL_START } from '../../lib/motion';

  const section = document.querySelector('[data-pillar-grid]');
  const label = document.querySelector('[data-pillar-grid-label]');

  if (section && label) {
    const enter = () => {
      scrambleIn(label, { trigger: section });
      revealUp('[data-pillar-grid] .section-head > *', {
        trigger: section,
        stagger: 0.09,
      });
      gsap.from('[data-pillar-card]', {
        autoAlpha: 0,
        y: 34,
        duration: 0.7,
        ease: EASE,
        stagger: 0.1,
        scrollTrigger: { trigger: '[data-pillar-grid] .pillar-cards', start: REVEAL_START },
      });
    };
    motionReady(section, { desktop: enter, mobile: enter });
  }
</script>

<style>
  .pillar-grid {
    background: var(--surface);
  }

  .pillar-cards {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: 1.5rem;
  }

  .pillar-card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow 200ms var(--ease-out-expo),
      transform 140ms var(--ease-out-quad),
      border-color 150ms ease;
  }

  .pillar-card:active {
    transform: scale(0.99);
    transition-duration: 90ms;
  }

  .pillar-card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--navy-deep);
  }

  .pillar-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 280ms var(--ease-out-expo);
  }

  .pillar-card-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(1, 30, 65, 0.7), rgba(1, 30, 65, 0.05) 60%);
  }

  .pillar-card-index {
    position: absolute;
    left: 1.25rem;
    bottom: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1;
    color: #fff;
  }

  /* Name, description, then the link pinned to the card foot so the
     "Explore pillar" row lines up across cards of differing length. */
  .pillar-card-body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.7rem;
    padding: 1.5rem 1.5rem 1.6rem;
  }

  .pillar-card-name {
    font-size: 1.02rem;
  }

  .pillar-card-description {
    color: var(--slate);
    font-size: 0.93rem;
  }

  .pillar-card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.3rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--blue);
    transition: color 150ms ease;
  }

  /* Grow toward the cursor, push the image in, lead with the chevron. */
  @media (hover: hover) and (pointer: fine) {
    .pillar-card:hover {
      transform: scale(1.01);
      border-color: rgba(0, 130, 202, 0.35);
      box-shadow: 0 14px 34px rgba(1, 30, 65, 0.1);
    }

    .pillar-card:hover .pillar-card-media img {
      transform: scale(1.05);
    }

    .pillar-card:hover .pillar-card-more {
      color: var(--orange);
    }

    .pillar-card:hover .btn-arrow {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-card,
    .pillar-card:hover,
    .pillar-card:active {
      transform: none;
    }

    .pillar-card:hover .pillar-card-media img,
    .pillar-card:hover .btn-arrow {
      transform: none;
    }
  }

  @media (max-width: 1023.98px) {
    .pillar-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639.98px) {
    .pillar-cards {
      grid-template-columns: 1fr;
    }
  }
</style>

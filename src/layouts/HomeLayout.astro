---
import '../styles/global.css';
import { getSiteSettings, mailHref, telHref } from '../content/home';

interface Props {
  title?: string;
  description?: string;
}

// The brand, the nav, and the contact block come from Site Settings, so the
// header and footer are edited in one place in the Studio.
const settings = await getSiteSettings();
const { title = settings.companyName, description = settings.tagline } = Astro.props;
const year = new Date().getFullYear();

// Marks the nav entry for the page (or section of pages) being viewed.
// Anchor hrefs never match - they point at homepage sections, not routes.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cousine:wght@400;700&family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" data-header>
      <div class="container header-inner">
        <a href="/" class="brand">
          {
            settings.logo ? (
              <img
                class="brand-logo"
                src={settings.logo.src}
                alt={settings.logo.alt || settings.companyName}
              />
            ) : (
              <Fragment>
                <span class="brand-mark">{settings.brandAbbr}</span>
                <span class="brand-name">{settings.companyName}</span>
              </Fragment>
            )
          }
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            settings.nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <button
          class="nav-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          data-nav-toggle
        >
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav class="mobile-nav" aria-label="Mobile" data-mobile-nav>
        {
          settings.nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer band-navy" id="contact">
      <div class="container footer-grid">
        <div>
          <p class="footer-brand">{settings.companyName}</p>
          <p class="footer-tagline">{settings.tagline}</p>
        </div>
        <div>
          <p class="footer-heading">Explore</p>
          {settings.nav.map((item) => <a class="footer-link" href={item.href}>{item.label}</a>)}
        </div>
        <div>
          <p class="footer-heading">Contact</p>
          <p class="footer-line">{settings.contact.address}</p>
          <a class="footer-link" href={mailHref(settings.contact.email)}>
            {settings.contact.email}
          </a>
          <a class="footer-link" href={telHref(settings.contact.phone)}>
            {settings.contact.phone}
          </a>
        </div>
      </div>
      <div class="container footer-legal">
        <p>© {year} {settings.companyName}, all rights reserved</p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('[data-nav-toggle]');
      const mobileNav = document.querySelector('[data-mobile-nav]');
      toggle?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
      });
      mobileNav?.addEventListener('click', (event) => {
        if ((event.target as Element).tagName === 'A') {
          mobileNav.classList.remove('open');
          toggle?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.25rem;
    gap: 2rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .brand-logo {
    height: 3.25rem;
    width: auto;
    max-width: 16rem;
    object-fit: contain;
  }

  .brand-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: #fff;
    background: var(--navy);
    padding: 0.35rem 0.5rem;
    border-radius: 0.35rem;
    letter-spacing: 0.08em;
  }

  .brand-name {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--navy);
    font-size: 0.95rem;
  }

  .site-nav {
    display: flex;
    gap: 1.75rem;
  }

  .site-nav a {
    position: relative;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
    letter-spacing: 0.01em;
    padding-block: 0.35rem;
    transition: color 150ms ease;
  }

  /* Underline sweeps in from the left on hover. */
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 220ms var(--ease-out-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav a:hover {
      color: var(--blue);
    }

    .site-nav a:hover::after {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav a::after {
      transition: none;
    }
  }

  /* The current section of the site keeps its underline. */
  .site-nav a[aria-current='page'] {
    color: var(--blue);
  }

  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
  }

  .nav-toggle span {
    width: 22px;
    height: 2px;
    background: var(--navy);
  }

  /* Overlays the page instead of expanding the header and pushing it. */
  .mobile-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    border-top: 1px solid var(--line);
    background: var(--bg);
    padding: 0.75rem clamp(1.25rem, 4vw, 2.5rem) 1.25rem;
    box-shadow: 0 18px 32px rgba(1, 30, 65, 0.14);
  }

  .mobile-nav a {
    padding: 0.7rem 0;
    color: var(--navy);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--blue);
  }

  @media (max-width: 1023.98px) {
    .site-nav {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }

  .site-footer {
    padding-block: 4rem 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.4fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.66);
    max-width: 26rem;
  }

  .footer-heading {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    color: var(--orange);
    margin-bottom: 1rem;
  }

  .footer-link,
  .footer-line {
    display: block;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    margin-bottom: 0.55rem;
    font-size: 0.95rem;
  }

  .footer-link:hover {
    color: var(--orange);
  }

  .footer-legal {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-block: 1.4rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 1023.98px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

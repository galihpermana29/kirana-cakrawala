---
import '../styles/global.css';
import { urlFor } from '../lib/image';
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings;
  title?: string;
  description?: string;
}

const { settings, title, description } = Astro.props;
const pageTitle = title ?? settings.companyName;

const themeVars = [
  settings.primaryColor?.hex && `--color-primary: ${settings.primaryColor.hex}`,
  settings.accentColor?.hex && `--color-accent: ${settings.accentColor.hex}`,
]
  .filter(Boolean)
  .join('; ');

const year = new Date().getFullYear();
---

<html lang="en" style={themeVars || undefined}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          {
            settings.logo?.asset ? (
              <img
                src={urlFor(settings.logo).height(72).url()}
                alt={settings.companyName}
                class="brand-logo"
              />
            ) : (
              <span class="brand-name">{settings.companyName}</span>
            )
          }
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {year} {settings.footerText ?? settings.companyName}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  .header-inner {
    display: flex;
    align-items: center;
    min-height: 4rem;
  }

  .brand {
    text-decoration: none;
  }

  .brand-logo {
    height: 2.25rem;
    width: auto;
  }

  .brand-name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-primary);
  }

  .site-footer {
    padding-block: 2.5rem;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.9rem;
  }
</style>

---
import ArticleFeed from '../../components/news/ArticleFeed.astro';
import PillarCta from '../../components/what-we-do/PillarCta.astro';
import PillarHero from '../../components/what-we-do/PillarHero.astro';
import { getSiteSettings } from '../../content/home';
import { getArticles, getNewsPage, visibleSections } from '../../content/news';
import HomeLayout from '../../layouts/HomeLayout.astro';

// The News & Articles listing: the nav's landing point and the full archive,
// newest first. Its bands come from the page document; the archive itself is
// the Article collection, ordered by publication date.
const [settings, page, articles] = await Promise.all([
  getSiteSettings(),
  getNewsPage(),
  getArticles(),
]);
---

<HomeLayout title={page.metaTitle} description={page.metaDescription}>
  {
    visibleSections(page.sections).map((section) => (
      <Fragment>
        {section._type === 'pageHeroSection' && (
          <PillarHero
            crumb={settings.brandAbbr}
            eyebrow={page.title}
            heading={section.heading}
            standfirst={section.standfirst}
            image={section.image}
            primary={section.primary}
            secondary={section.secondary}
          />
        )}
        {section._type === 'articleFeedSection' && <ArticleFeed head={section} articles={articles} />}
        {section._type === 'ctaSection' && (
          <PillarCta
            label={section.label}
            heading={section.heading}
            body={section.body}
            primary={section.primary}
            secondary={section.secondary}
            image={settings.ctaImage}
          />
        )}
      </Fragment>
    ))
  }
</HomeLayout>

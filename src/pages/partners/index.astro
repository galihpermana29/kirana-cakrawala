---
import PartnerCategories from '../../components/partners/PartnerCategories.astro';
import PartnerNetwork from '../../components/partners/PartnerNetwork.astro';
import PillarCta from '../../components/what-we-do/PillarCta.astro';
import PillarGrid from '../../components/what-we-do/PillarGrid.astro';
import PillarHero from '../../components/what-we-do/PillarHero.astro';
import PillarOverview from '../../components/what-we-do/PillarOverview.astro';
import { getSiteSettings } from '../../content/home';
import { getPartnersPage, visibleSections } from '../../content/partners';
import HomeLayout from '../../layouts/HomeLayout.astro';

// The Partners page: mission 5 expanded - who KCA partners with and what the
// integrated ecosystem means for each of them. The seven categories and the
// map pins are collections, referenced by the bands that show them.
const [settings, page] = await Promise.all([getSiteSettings(), getPartnersPage()]);
---

<HomeLayout title={page.metaTitle} description={page.metaDescription}>
  {
    visibleSections(page.sections).map((section) => (
      <Fragment>
        {section._type === 'pageHeroSection' && (
          <PillarHero
            crumb={settings.brandAbbr}
            eyebrow={page.title}
            heading={section.heading}
            standfirst={section.standfirst}
            image={section.image}
            primary={section.primary}
            secondary={section.secondary}
          />
        )}
        {section._type === 'overviewSection' && <PillarOverview overview={section} />}
        {section._type === 'partnerCategoriesSection' && <PartnerCategories head={section} items={section.categories} />}
        {section._type === 'networkSection' && <PartnerNetwork section={section} brandAbbr={settings.brandAbbr} />}
        {section._type === 'pillarGridSection' && <PillarGrid head={section} items={section.pillars} />}
        {section._type === 'ctaSection' && (
          <PillarCta
            label={section.label}
            heading={section.heading}
            body={section.body}
            primary={section.primary}
            secondary={section.secondary}
            image={settings.ctaImage}
          />
        )}
      </Fragment>
    ))
  }
</HomeLayout>
